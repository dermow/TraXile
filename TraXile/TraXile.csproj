<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TraXile core (docs/adr/0001): log parsing, tracking, SQLite database and statistics.
    A class library since 3.0; the UI is TraXile.Next (TraXile.exe).
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>TraXile</RootNamespace>
    <AssemblyName>TraXile.Core</AssemblyName>
    <!-- Version and InternalsVisibleTo live in Properties\AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- Local only, never compiled (was not part of the 2.x project either) -->
    <Compile Remove="TrX_Secrets.cs" />
    <!-- Work in progress that the 2.x project did not compile either -->
    <Compile Remove="TrX_TrackedLabrun.cs;Enhanced\**" />
    <!-- Leftovers of the 2.x ClickOnce publishing and the removed WinForms UI -->
    <Compile Remove="publish\**;UI\**" />
    <None Remove="publish\**;UI\**;*.pfx" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="log4net" Version="3.5.0" />
    <!-- Brings the matching SQLitePCLRaw.bundle_e_sqlite3 (native e_sqlite3) -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tag sounds (TrX_SoundManager plays them from <app>\audio) and the logging setup; copied into the app -->
    <Content Include="audio\*.mp3" CopyToOutputDirectory="PreserveNewest" />
    <None Update="log4net.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
