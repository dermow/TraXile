<ui:FluentWindow
    x:Class="TraXile.Next.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:pages="clr-namespace:TraXile.Next.Views"
    Title="TraXile"
    Width="1440"
    Height="940"
    MinWidth="1100"
    MinHeight="700"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    FontFamily="{StaticResource UiFontText}">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="TraXile" ShowMaximize="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Timer24" Foreground="{StaticResource BrandAccentBrush}" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="ModeBadge" Margin="0,0,12,0" Padding="8,2" CornerRadius="999"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="ModeText" Text="LIVE" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <ui:Button x:Name="ThemeButton" Appearance="Transparent" Padding="8" Margin="0,0,8,0"
                               ToolTip="Toggle light / dark theme" Click="ThemeButton_Click">
                        <ui:Button.Icon>
                            <ui:SymbolIcon x:Name="ThemeIcon" Symbol="WeatherSunny24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="232"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            FrameMargin="0"
            Transition="FadeInWithSlide">

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Dashboard" TargetPageType="{x:Type pages:DashboardPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Home24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Activity log" TargetPageType="{x:Type pages:ActivityLogPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="History24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Statistics" TargetPageType="{x:Type pages:StatisticsPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="DataTrending24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Mapping" TargetPageType="{x:Type pages:MappingPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Map24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Bossing" TargetPageType="{x:Type pages:BossingPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Trophy24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Labs &amp; Heist" TargetPageType="{x:Type pages:LabHeistPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Shield24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Tags" TargetPageType="{x:Type pages:TagsPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="TagMultiple24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings" TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Settings24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
