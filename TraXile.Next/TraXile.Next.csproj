<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>TraXile.Next</RootNamespace>
    <AssemblyName>TraXile.Next</AssemblyName>
    <!-- Native libs (SkiaSharp, e_sqlite3) are resolved per architecture -->
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>..\TraXile\ic-task.ico</ApplicationIcon>
    <Version>3.0.0-preview1</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Modern Fluent (Windows 11) UI framework -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <!-- Modern animated charts -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <!-- MVVM helpers -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <!-- Native dependencies of the reused TraXile core (do not flow through ProjectReference on .NET Framework) -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="5.0.7" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.0.4" />
    <PackageReference Include="log4net" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse the existing, battle-tested tracking core (log parsing, DB, stats) -->
    <ProjectReference Include="..\TraXile\TraXile.csproj" />
  </ItemGroup>

</Project>
