<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      Windows SDK TFM: SkiaSharp.Views.WPF (LiveCharts) only ships .NET assets for windows10.0.19041;
      with plain net10.0-windows NuGet falls back to its .NET Framework build (NU1701).
    -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Notification area icon (WPF has none) -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>TraXile.Next</RootNamespace>
    <!-- TraXile.exe like 2.x, so shortcuts, taskbar pins and the updater keep working after the upgrade -->
    <AssemblyName>TraXile</AssemblyName>
    <Product>TraXile</Product>
    <Company>dermow</Company>
    <ApplicationIcon>TraXile.ico</ApplicationIcon>
    <Version>3.0.5</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Modern Fluent (Windows 11) UI framework -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <!-- Modern animated charts -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <!-- LiveCharts brings 3.119.0, which has no net10.0 assets; same library, newer patch -->
    <PackageReference Include="SkiaSharp.Views.WPF" Version="3.119.4" />
    <!-- MVVM helpers -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Microsoft.Data.Sqlite, log4net and Newtonsoft.Json flow in from the core -->
  </ItemGroup>

  <ItemGroup>
    <!-- Design system fonts (SIL OFL 1.1), see docs/design.md -->
    <Resource Include="Fonts\*.ttf" />
    <!-- Window / taskbar icon: WPF windows don't pick up the exe's ApplicationIcon on their own -->
    <Resource Include="TraXile.ico" />
    <None Include="Fonts\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse the existing, battle-tested tracking core (log parsing, DB, stats) -->
    <ProjectReference Include="..\TraXile\TraXile.csproj" />
    <!-- The updater is started from the app folder ("Install update"); built and copied, not referenced -->
    <ProjectReference Include="..\TraXile.Updater\TraXile.Updater.csproj" ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
