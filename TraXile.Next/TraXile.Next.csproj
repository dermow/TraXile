<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>TraXile.Next</RootNamespace>
    <AssemblyName>TraXile.Next</AssemblyName>
    <!-- Native libs (SkiaSharp, e_sqlite3) are resolved per architecture -->
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>..\TraXile\ic-task.ico</ApplicationIcon>
    <Version>3.0.0-preview1</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Modern Fluent (Windows 11) UI framework -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <!-- Modern animated charts -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <!-- MVVM helpers -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <!-- Native dependencies of the reused TraXile core (do not flow through ProjectReference on .NET Framework) -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="5.0.7" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.0.4" />
    <PackageReference Include="log4net" Version="3.1.0" />
    <!-- Same serializer and version as the core, so the JSON export equals the classic one -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Notification area icon (WPF has none) -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- Support bundle (zip) -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <!-- Design system fonts (SIL OFL 1.1), see docs/design.md -->
    <Resource Include="Fonts\*.ttf" />
    <None Include="Fonts\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse the existing, battle-tested tracking core (log parsing, DB, stats) -->
    <ProjectReference Include="..\TraXile\TraXile.csproj" />
    <!-- The updater is started from the app folder ("Install update"); built and copied, not referenced -->
    <ProjectReference Include="..\TraXile.Updater\TraXile.Updater.csproj" ReferenceOutputAssembly="false"
                      OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
