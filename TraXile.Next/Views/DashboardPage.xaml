<Page
    x:Class="TraXile.Next.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:vm="clr-namespace:TraXile.Next.ViewModels"
    Title="Dashboard">

    <Page.Resources>
        <!-- KPI delta: success or danger text on a quiet veil -->
        <Style x:Key="DeltaPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Background" Value="{DynamicResource HoverVeilBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource StatusSuccessBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DeltaPositive}" Value="False">
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource StatusDangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasDelta}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TagChip">
            <Border Style="{StaticResource Chip}" Background="{Binding Background}">
                <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}" FontSize="12" FontWeight="SemiBold" />
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>

        <!-- Small legend key of the trend chart -->
        <Style x:Key="LegendText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,16,0" />
        </Style>

        <!-- Charts blend into the cards; legend/tooltip text follows the theme -->
        <Style TargetType="lvc:CartesianChart">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="LegendTextSize" Value="12" />
            <Setter Property="TooltipTextSize" Value="12" />
            <Setter Property="LegendTextPaint" Value="{Binding DataContext.ChartTextPaint, RelativeSource={RelativeSource AncestorType=Page}}" />
        </Style>
        <Style TargetType="lvc:PieChart">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TooltipTextSize" Value="12" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource PagePadding}">

            <!-- ============ Header ============ -->
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource Meta}" Margin="0,4,0,0">
                        <Run Text="Your Path of Exile sessions at a glance" />
                        <Run Text=" · " />
                        <Run Text="{Binding RangeLabel, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <Border Style="{StaticResource SegmentedGroup}" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="Today"
                                     Command="{Binding SetRangeCommand}" CommandParameter="Today" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="7 days" IsChecked="True"
                                     Command="{Binding SetRangeCommand}" CommandParameter="Week" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="30 days"
                                     Command="{Binding SetRangeCommand}" CommandParameter="Month" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="All time"
                                     Command="{Binding SetRangeCommand}" CommandParameter="All" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Notices (demo mode, restored backup, ...) -->
            <ItemsControl ItemsSource="{Binding Notices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NoticeItem}">
                        <Border x:Name="Bd" Style="{StaticResource Notice}" Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap">
                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Text, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" />
                            </TextBlock>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StatusDangerBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============ Live card ============ -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="28,24,28,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Rectangle Width="7" Height="7" Fill="{Binding LiveBrush}" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Rectangle.RenderTransform>
                                        <RotateTransform Angle="45" CenterX="3.5" CenterY="3.5" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <TextBlock Foreground="{DynamicResource AccentTextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Label}">
                                            <Setter Property="Text" Value="NOW TRACKING" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Live.IsPaused}" Value="True">
                                                    <Setter Property="Text" Value="PAUSED" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Live.IsTracking}" Value="False">
                                                    <Setter Property="Text" Value="IDLE" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Text="{Binding LiveTitle}" Style="{StaticResource H2}" FontSize="30" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding LiveSubtitle}" Style="{StaticResource Meta}" FontSize="14" Margin="0,4,0,12" />

                            <ItemsControl ItemsSource="{Binding Live.ActiveTags}" ItemTemplate="{StaticResource TagChip}"
                                          ItemsPanel="{StaticResource WrapPanelTemplate}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="320" Margin="24,0,0,0">
                            <Grid>
                                <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource Metric}" FontSize="60" HorizontalAlignment="Left" />
                                <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center" Appearance="Secondary"
                                           Padding="10,0" MinHeight="40" Command="{Binding TogglePauseCommand}"
                                           IsEnabled="{Binding Live.IsTracking}" ToolTip="Pause or resume the stopwatch">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon>
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="Pause24" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Live.IsPaused}" Value="True">
                                                            <Setter Property="Symbol" Value="Play24" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                            <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding LiveProgress, Mode=OneWay}"
                                         Foreground="{Binding LiveBrush}" Margin="0,8,0,8" />
                            <TextBlock Text="{Binding LiveCompare}" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Grid>

                    <!-- Trend: coral curve, dashed previous period, brass death markers -->
                    <Grid Grid.Row="1" Margin="28,8,28,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TrendTitle}" Style="{StaticResource Caption}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,20,0" />
                            <Rectangle Width="14" Height="2.5" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="this period" Style="{StaticResource LegendText}" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasPreviousTrend, Converter={StaticResource BoolToVis}}">
                                <Line X1="0" X2="14" Y1="1" Y2="1" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5"
                                      StrokeDashArray="2.5 2.5" VerticalAlignment="Center" />
                                <TextBlock Text="previous period" Style="{StaticResource LegendText}" />
                            </StackPanel>
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource BrassBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="death" Style="{StaticResource LegendText}" />
                        </StackPanel>
                        <lvc:CartesianChart Grid.Row="1" Height="120" Margin="-6,4,-6,0"
                                            Series="{Binding TrendSeries}" XAxes="{Binding TrendXAxes}" YAxes="{Binding TrendYAxes}"
                                            DrawMargin="{Binding TrendMargin}" LegendPosition="Hidden" TooltipPosition="Top" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ============ KPI tiles ============ -->
            <ItemsControl ItemsSource="{Binding Kpis}" Margin="-8,0,-8,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:KpiViewModel}">
                        <Border Style="{StaticResource Card}" Margin="8" Padding="20,16,20,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="7" Height="7" Fill="{Binding AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Label}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource Metric}" />
                                    <TextBlock Text="{Binding Unit}" Style="{StaticResource Meta}" FontSize="16"
                                               VerticalAlignment="Bottom" Margin="3,0,0,5" />
                                </StackPanel>
                                <Border Style="{StaticResource DeltaPill}" HorizontalAlignment="Left" Margin="0,4,0,0">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular">
                                        <Run Text="{Binding Delta, Mode=OneWay}" /><Run Text="  vs. prev." FontWeight="Normal" />
                                    </TextBlock>
                                </Border>
                                <lvc:CartesianChart Series="{Binding Sparkline}" Height="44" Margin="-4,8,-4,0"
                                                    XAxes="{Binding SparkXAxes}" YAxes="{Binding SparkYAxes}"
                                                    DrawMargin="{Binding SparkMargin}"
                                                    TooltipPosition="Hidden" LegendPosition="Hidden"
                                                    IsHitTestVisible="False" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============ Charts ============ -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" MinWidth="380" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding DailyTitle}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Hours spent per activity type" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <lvc:CartesianChart Grid.Row="1" Height="320" Margin="0,12,0,0"
                                            Series="{Binding DailySeries}"
                                            XAxes="{Binding DailyXAxes}"
                                            YAxes="{Binding DailyYAxes}"
                                            LegendPosition="Top"
                                            TooltipPosition="Top" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Time distribution" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Where your time went" Style="{StaticResource Caption}" Margin="0,2,0,0" />

                        <Grid Height="220" Margin="0,8,0,8">
                            <lvc:PieChart Series="{Binding TimeSeries}" InitialRotation="-90" LegendPosition="Hidden" TooltipPosition="Center" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="{Binding TotalHours}" Style="{StaticResource Metric}" FontSize="30" HorizontalAlignment="Center" />
                                <TextBlock Text="hours total" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding TimeLegend}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LegendItem}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Brush}" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Body}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Hours}" Style="{StaticResource Caption}" FontSize="13" HorizontalAlignment="Right"
                                                   Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Grid.Column="3" Text="{Binding Percent}" Style="{StaticResource Num}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ Recent activities: row cards on the page ============ -->
            <Grid Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Recent activities" Style="{StaticResource H3}" />
                    <TextBlock Text="Your latest activities" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                </StackPanel>
                <ui:Button Content="View all" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Appearance="Transparent" Click="ViewAll_Click" />
            </Grid>

            <!-- column header -->
            <Grid Margin="19,0,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>
                </Grid.Resources>
                <TextBlock Text="Activity" />
                <TextBlock Grid.Column="1" Text="Level" />
                <TextBlock Grid.Column="2" Text="Tags" />
                <TextBlock Grid.Column="3" Text="Started" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Text="Duration" HorizontalAlignment="Right" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Recent}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource LiveRowCard}" Margin="0,0,0,4" Padding="16,8" BorderThickness="3,0,0,0">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{Binding TypeBrush.Color}" Opacity="0.82" />
                            </Border.BorderBrush>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Area}" Style="{StaticResource Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding TypeName}" Style="{StaticResource Caption}" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding LevelText}" Style="{StaticResource Num}" VerticalAlignment="Center" />

                                <ItemsControl Grid.Column="2" ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource TagChip}"
                                              ItemsPanel="{StaticResource WrapPanelTemplate}" VerticalAlignment="Center" Margin="0,6,0,0" />

                                <TextBlock Grid.Column="3" Text="{Binding StartedText}" Style="{StaticResource Meta}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding Duration}" Style="{StaticResource Num}" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
