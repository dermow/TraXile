<Page
    x:Class="TraXile.Next.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:vm="clr-namespace:TraXile.Next.ViewModels"
    Title="Dashboard">

    <Page.Resources>
        <!-- KPI delta pill: green when good, red when bad -->
        <Style x:Key="DeltaPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Background" Value="#2234D399" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource StatusSuccessBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DeltaPositive}" Value="False">
                    <Setter Property="Background" Value="#22FB7185" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource StatusDangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasDelta}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TagChip">
            <Border Style="{StaticResource Chip}" Background="{Binding Background}">
                <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}" FontSize="12" FontWeight="SemiBold" />
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>

        <!-- Charts blend into the cards; legend/tooltip text follows the theme -->
        <Style TargetType="lvc:CartesianChart">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="LegendTextSize" Value="12" />
            <Setter Property="TooltipTextSize" Value="12" />
            <Setter Property="LegendTextPaint" Value="{Binding DataContext.ChartTextPaint, RelativeSource={RelativeSource AncestorType=Page}}" />
        </Style>
        <Style TargetType="lvc:PieChart">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TooltipTextSize" Value="12" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,20,36,36">

            <!-- ============ Header ============ -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Dashboard" FontFamily="{StaticResource UiFont}" FontSize="30" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,0">
                        <Run Text="Your Path of Exile sessions at a glance" />
                        <Run Text=" · " />
                        <Run Text="{Binding RangeLabel, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="3" CornerRadius="8"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="Today"
                                     Command="{Binding SetRangeCommand}" CommandParameter="Today" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="7 days" IsChecked="True"
                                     Command="{Binding SetRangeCommand}" CommandParameter="Week" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="30 days"
                                     Command="{Binding SetRangeCommand}" CommandParameter="Month" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="All time"
                                     Command="{Binding SetRangeCommand}" CommandParameter="All" />
                    </StackPanel>
                </Border>
            </Grid>

            <ui:InfoBar Title="Demo mode" Message="{Binding Notice}" IsOpen="{Binding HasNotice, Mode=OneWay}"
                        Severity="Informational" IsClosable="True" Margin="0,0,0,16" />

            <!-- ============ Live tracking hero ============ -->
            <Border Style="{StaticResource DashCard}" Padding="0" Margin="0,0,0,16" ClipToBounds="True">
                <Grid>
                    <!-- soft color glow of the current activity type -->
                    <Border CornerRadius="10" Opacity="0.16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="{Binding LiveBrush.Color}" />
                                <GradientStop Offset="0.6" Color="Transparent" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Grid Margin="28,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border CornerRadius="999" Padding="9,2" Background="{Binding LiveBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="#18181B" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="#18181B">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="NOW TRACKING" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Live.IsPaused}" Value="True">
                                                            <Setter Property="Text" Value="PAUSED" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Live.IsTracking}" Value="False">
                                                            <Setter Property="Text" Value="IDLE" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding LiveTitle}" FontFamily="{StaticResource UiFont}" FontSize="32" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding LiveSubtitle}" Style="{StaticResource Body}" Margin="0,2,0,12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <ItemsControl ItemsSource="{Binding Live.ActiveTags}" ItemTemplate="{StaticResource TagChip}"
                                          ItemsPanel="{StaticResource WrapPanelTemplate}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="340" Margin="24,0,0,0">
                            <Grid>
                                <TextBlock Text="{Binding ElapsedText}" FontFamily="{StaticResource UiFont}" FontSize="64" FontWeight="SemiBold"
                                           Typography.NumeralAlignment="Tabular" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center" Appearance="Secondary"
                                           Padding="14,10" Command="{Binding TogglePauseCommand}"
                                           IsEnabled="{Binding Live.IsTracking}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon>
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="Pause24" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Live.IsPaused}" Value="True">
                                                            <Setter Property="Symbol" Value="Play24" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                            <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding LiveProgress, Mode=OneWay}"
                                         Foreground="{Binding LiveBrush}" Margin="0,8,0,8" />
                            <TextBlock Text="{Binding LiveCompare}" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============ KPI cards ============ -->
            <ItemsControl ItemsSource="{Binding Kpis}" Margin="-6,0,-6,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:KpiViewModel}">
                        <Border Style="{StaticResource DashCard}" Margin="6" Padding="18,16,18,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" FontSize="13" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource Metric}" />
                                    <TextBlock Text="{Binding Unit}" Style="{StaticResource Caption}" FontSize="16"
                                               VerticalAlignment="Bottom" Margin="3,0,0,5" />
                                </StackPanel>
                                <Border Style="{StaticResource DeltaPill}" HorizontalAlignment="Left" Margin="0,4,0,0">
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <Run Text="{Binding Delta, Mode=OneWay}" /><Run Text="  vs. prev." FontWeight="Normal" />
                                    </TextBlock>
                                </Border>
                                <lvc:CartesianChart Series="{Binding Sparkline}" Height="44" Margin="-4,8,-4,0"
                                                    XAxes="{Binding SparkXAxes}" YAxes="{Binding SparkYAxes}"
                                                    DrawMargin="{Binding SparkMargin}"
                                                    TooltipPosition="Hidden" LegendPosition="Hidden"
                                                    IsHitTestVisible="False" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============ Charts ============ -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" MinWidth="380" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource DashCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding DailyTitle}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Hours spent per activity type" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <lvc:CartesianChart Grid.Row="1" Height="320" Margin="0,12,0,0"
                                            Series="{Binding DailySeries}"
                                            XAxes="{Binding DailyXAxes}"
                                            YAxes="{Binding DailyYAxes}"
                                            LegendPosition="Top"
                                            TooltipPosition="Top" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource DashCard}">
                    <StackPanel>
                        <TextBlock Text="Time distribution" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Where your time went" Style="{StaticResource Caption}" Margin="0,2,0,0" />

                        <Grid Height="220" Margin="0,8,0,8">
                            <lvc:PieChart Series="{Binding TimeSeries}" InitialRotation="-90" LegendPosition="Hidden" TooltipPosition="Center" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="{Binding TotalHours}" Style="{StaticResource Metric}" FontSize="30" HorizontalAlignment="Center" />
                                <TextBlock Text="hours total" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding TimeLegend}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LegendItem}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Brush}" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Body}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Hours}" Style="{StaticResource Caption}" FontSize="13" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{Binding Percent}" Style="{StaticResource Body}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ Recent activities ============ -->
            <Border Style="{StaticResource DashCard}" Padding="0">
                <StackPanel>
                    <Grid Margin="20,18,20,10">
                        <StackPanel>
                            <TextBlock Text="Recent activities" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Your latest runs" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:Button Content="View all" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,5"
                                   Appearance="Transparent" Click="ViewAll_Click" />
                    </Grid>

                    <!-- column header -->
                    <Grid Margin="20,4,20,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Activity" Style="{StaticResource Overline}" />
                        <TextBlock Grid.Column="1" Text="Level" Style="{StaticResource Overline}" />
                        <TextBlock Grid.Column="2" Text="Tags" Style="{StaticResource Overline}" />
                        <TextBlock Grid.Column="3" Text="Started" Style="{StaticResource Overline}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="Duration" Style="{StaticResource Overline}" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <ItemsControl ItemsSource="{Binding Recent}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Padding="20,10" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.2*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="34" Height="34" CornerRadius="8" Margin="0,0,12,0">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding TypeBrush.Color}" Opacity="0.18" />
                                                </Border.Background>
                                                <Ellipse Width="10" Height="10" Fill="{Binding TypeBrush}" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Area}" Style="{StaticResource Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding TypeName}" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding LevelText}" Style="{StaticResource Body}" VerticalAlignment="Center" />

                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource TagChip}"
                                                      ItemsPanel="{StaticResource WrapPanelTemplate}" VerticalAlignment="Center" Margin="0,6,0,0" />

                                        <TextBlock Grid.Column="3" Text="{Binding StartedText}" Style="{StaticResource Caption}" FontSize="13"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding Duration}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                                   Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
