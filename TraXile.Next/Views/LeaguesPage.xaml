<Page
    x:Class="TraXile.Next.Views.LeaguesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:vm="clr-namespace:TraXile.Next.ViewModels"
    xmlns:views="clr-namespace:TraXile.Next.Views"
    Title="Leagues">

    <StackPanel Margin="{StaticResource PagePadding}">
        <!-- ============ Header ============ -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Leagues" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Your last leagues side by side." Style="{StaticResource Meta}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Compare the last" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox Width="80" ItemsSource="{Binding LeagueCounts}" SelectedItem="{Binding LeagueCount}" />
                <TextBlock Text="leagues" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
        </Grid>

        <views:GlobalFilterBar Margin="0,0,0,8" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,16" TextWrapping="Wrap"
                   Text="Type, area, level and tags of the filter apply here. Its time range does not: each league uses its own play period." />

        <TextBlock Text="No league information yet. TraXile downloads the leagues at start; check your internet connection and restart TraXile."
                   Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,8"
                   Visibility="{Binding HasLeagues, Converter={StaticResource InvBoolToVis}}" />

        <!-- ============ Eight charts, two per row ============ -->
        <ItemsControl ItemsSource="{Binding Charts}" Margin="0,0,-16,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:LeagueChart}">
                    <Border Style="{StaticResource Card}" Margin="0,0,16,16">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardHeading}" />
                            <lvc:CartesianChart Height="220" Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                                                TooltipPosition="Top" LegendPosition="Hidden" Background="Transparent" />
                            <TextBlock Text="{Binding Note}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CardNote}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Page>
