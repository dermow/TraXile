<Page
    x:Class="TraXile.Next.Views.HelpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:TraXile.Next.ViewModels"
    Title="Help">

    <Page.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="LinkText" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="TextDecorations" Value="None" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- input (command, search) on the left, what it does on the right -->
        <DataTemplate x:Key="HelpEntryRow" DataType="{x:Type vm:HelpEntry}">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource BgBrush}" CornerRadius="{StaticResource ControlRadius}"
                        Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Input}" Style="{StaticResource Num}" FontWeight="SemiBold" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Description}" Style="{StaticResource Body}" TextWrapping="Wrap"
                           Margin="0,3,0,0" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="Help" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Chat commands, searching the activity log, support and everything about TraXile."
                       Style="{StaticResource Meta}" Margin="0,4,0,24" />

            <!-- ============ About ============ -->
            <TextBlock Text="ABOUT" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Timer24" FontSize="28" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0" />
                            <TextBlock Text="TraXile" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="24"
                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Body}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Text="Tracks what you do in Path of Exile by reading the game's log, and turns it into history and statistics." />
                        <TextBlock Style="{StaticResource Meta}" Margin="0,8,0,0">
                            <Run Text="Version" /> <Run Text="{Binding Version, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            <Run Text="  ·  built by dermow" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{x:Static vm:HelpViewModel.Links}" Margin="0,14,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HelpLink}">
                                    <TextBlock Style="{StaticResource Body}" Margin="0,0,20,0">
                                        <Hyperlink Style="{StaticResource LinkText}" NavigateUri="{Binding Url}" ToolTip="{Binding Url}"
                                                   RequestNavigate="Link_RequestNavigate">
                                            <Run Text="{Binding Label, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- update state -->
                    <StackPanel Grid.Column="1" Margin="32,0,0,0" MinWidth="220" DataContext="{Binding Update}">
                        <TextBlock Text="UPDATES" Style="{StaticResource Label}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Body}" TextWrapping="Wrap" MaxWidth="260"
                                   HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:Button Content="Check for updates" Click="CheckUpdates_Click" IsEnabled="{Binding CanCheck}">
                                <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowSync20" /></ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Chat commands ============ -->
            <TextBlock Text="CHAT COMMANDS" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,28">
                <StackPanel>
                    <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,0,0,16"
                               Text="Type these in any chat channel of Path of Exile (e.g. the local chat) to control TraXile while you play." />
                    <ItemsControl ItemsSource="{x:Static vm:HelpViewModel.ChatCommands}" ItemTemplate="{StaticResource HelpEntryRow}" />
                </StackPanel>
            </Border>

            <!-- ============ Search ============ -->
            <TextBlock Text="SEARCHING THE ACTIVITY LOG" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,28">
                <StackPanel>
                    <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,0,0,16"
                               Text="The search box of the activity log (Ctrl+F) finds activities by area, activity type, tier or level, and tag." />
                    <ItemsControl ItemsSource="{x:Static vm:HelpViewModel.SearchExamples}" ItemTemplate="{StaticResource HelpEntryRow}" />
                    <ItemsControl ItemsSource="{x:Static vm:HelpViewModel.SearchNotes}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Top"
                                             HorizontalAlignment="Left" Margin="0,7,0,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Meta}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ============ Credits ============ -->
            <TextBlock Text="SPECIAL THANKS" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,28">
                <ItemsControl ItemsSource="{x:Static vm:HelpViewModel.Credits}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:HelpLink}">
                            <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,8">
                                <Run Text="{Binding Label, Mode=OneWay}" />
                                <Run Text="  " />
                                <Hyperlink Style="{StaticResource LinkText}" NavigateUri="{Binding Url}" RequestNavigate="Link_RequestNavigate">
                                    <Run Text="{Binding Url, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
