<UserControl
    x:Class="TraXile.Next.Views.GlobalFilterBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:TraXile.Next.ViewModels">
    <!-- The shared filter bar of all analytics pages (DataContext: FilterBarViewModel, one instance for all pages). -->

    <UserControl.Resources>
        <!-- Combo box entry with color dot and count -->
        <DataTemplate x:Key="OptionTemplate" DataType="{x:Type vm:FilterOption}">
            <Grid MinWidth="120">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{Binding Brush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Brush}" Value="{x:Null}">
                    <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="TimeTemplate" DataType="{x:Type vm:TimeOption}">
            <Grid MinWidth="130">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Hint}" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- red outline for texts that cannot be parsed -->
        <Style x:Key="ValidatedBox" TargetType="{x:Type ui:TextBox}" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource StatusDangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Border Style="{StaticResource Card}" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel>
                    <!-- time -->
                    <ComboBox Margin="0,4,10,4" MinWidth="170" ToolTip="Time range"
                              ItemsSource="{Binding TimeOptions}" SelectedItem="{Binding SelectedTime}"
                              ItemTemplate="{StaticResource TimeTemplate}" MaxDropDownHeight="420" />

                    <!-- custom date/time range -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,10,4"
                                Visibility="{Binding IsCustomTime, Converter={StaticResource BoolToVis}}">
                        <DatePicker Width="130" Height="36" Padding="10,0,4,0" VerticalContentAlignment="Center" SelectedDateFormat="Short" VerticalAlignment="Center" SelectedDate="{Binding CustomFromDate}" ToolTip="From (date)" />
                        <ui:TextBox Width="76" Margin="4,0,0,0" VerticalAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource ValidatedBox}" ToolTip="From (time, HH:mm)"
                                    Text="{Binding CustomFromTime, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding CustomFromTimeInvalid}" />
                        <TextBlock Text="–" Style="{StaticResource Body}" Margin="8,0" VerticalAlignment="Center" />
                        <DatePicker Width="130" Height="36" Padding="10,0,4,0" VerticalContentAlignment="Center" SelectedDateFormat="Short" VerticalAlignment="Center" SelectedDate="{Binding CustomToDate}" ToolTip="To (date)" />
                        <ui:TextBox Width="76" Margin="4,0,0,0" VerticalAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource ValidatedBox}" ToolTip="To (time, HH:mm)"
                                    Text="{Binding CustomToTime, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding CustomToTimeInvalid}" />
                    </StackPanel>

                    <!-- activity type -->
                    <ComboBox Margin="0,4,10,4" MinWidth="160" ToolTip="Activity type"
                              ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}"
                              ItemTemplate="{StaticResource OptionTemplate}" MaxDropDownHeight="420" />

                    <!-- area -->
                    <ComboBox Margin="0,4,10,4" MinWidth="160" ToolTip="Area (type to jump)"
                              ItemsSource="{Binding AreaOptions}" SelectedItem="{Binding SelectedArea}"
                              ItemTemplate="{StaticResource OptionTemplate}" MaxDropDownHeight="420"
                              IsTextSearchEnabled="True" TextSearch.TextPath="Label" />

                    <!-- area level -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,10,4" ToolTip="Area level">
                        <ComboBox Width="64" ItemsSource="{Binding LevelOperators}" SelectedItem="{Binding SelectedLevelOperator}"
                                  DisplayMemberPath="Label" />
                        <ui:TextBox Width="76" Margin="4,0,0,0" PlaceholderText="Level" Style="{StaticResource ValidatedBox}"
                                    Text="{Binding LevelText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding LevelInvalid}" />
                    </StackPanel>

                    <!-- tags -->
                    <ui:Button x:Name="TagsButton" Margin="0,4,10,4" MinWidth="110" HorizontalContentAlignment="Left"
                               Appearance="Secondary" Click="TagsButton_Click" ToolTip="Tags">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Tag20" /></ui:Button.Icon>
                        <ui:Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TagButtonText}" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                                <ui:SymbolIcon Symbol="ChevronDown16" FontSize="12" Margin="8,0,0,0" />
                            </StackPanel>
                        </ui:Button.Content>
                        <ui:Button.ContextMenu>
                            <ContextMenu x:Name="TagsMenu" MaxHeight="440">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="IsCheckable" Value="True" />
                                        <Setter Property="StaysOpenOnClick" Value="True" />
                                        <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=TwoWay}" />
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                                <ContextMenu.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TagChoice}">
                                        <Grid MinWidth="180">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource Chip}" Background="{Binding Background}" Padding="8,1" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}" FontSize="12" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource Caption}" Margin="16,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ContextMenu.ItemTemplate>
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>

                    <ComboBox Margin="0,4,10,4" MinWidth="150" ToolTip="How the selected tags combine"
                              ItemsSource="{Binding TagMatches}" SelectedItem="{Binding SelectedTagMatch}" DisplayMemberPath="Label"
                              Visibility="{Binding HasTagFilter, Converter={StaticResource BoolToVis}}" />
                </WrapPanel>

                <ui:Button Grid.Column="1" VerticalAlignment="Top" Margin="0,4,0,4" Appearance="Transparent" ToolTip="Reset the filter"
                           Command="{Binding ResetCommand}" IsEnabled="{Binding IsActive}">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="FilterDismiss20" /></ui:Button.Icon>
                </ui:Button>
            </Grid>
        </Border>

        <!-- "filter active" banner -->
        <Border Style="{StaticResource Notice}" Margin="0,8,0,0" Padding="16,6,8,6"
                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="FILTERED" Style="{StaticResource Label}" Foreground="{DynamicResource AccentTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Text="{Binding Description}" Style="{StaticResource Body}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Description}" />
                <ui:Button Grid.Column="2" Content="Reset filter" Appearance="Transparent" Style="{StaticResource SmallButton}"
                           Margin="12,0,0,0" Command="{Binding ResetCommand}" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
