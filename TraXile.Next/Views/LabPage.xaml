<Page
    x:Class="TraXile.Next.Views.LabPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:svc="clr-namespace:TraXile.Next.Services"
    xmlns:vm="clr-namespace:TraXile.Next.ViewModels"
    xmlns:views="clr-namespace:TraXile.Next.Views"
    Title="Lab">

    <Page.Resources>
        <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock" BasedOn="{StaticResource Num}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <StackPanel Margin="{StaticResource PagePadding}">
        <!-- ============ Header ============ -->
        <Grid Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Lab" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Meta}" Margin="0,4,0,0" />
            </StackPanel>
            <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Content="Hide unknown labs"
                      IsChecked="{Binding HideUnknown}" ToolTip="Leave out lab runs whose difficulty TraXile could not tell" />
        </Grid>

        <views:GlobalFilterBar Margin="0,0,0,16" />

        <!-- ============ Charts ============ -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Labs done" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Runs without deaths per lab" Style="{StaticResource CardSubtitle}" />
                    <lvc:CartesianChart Height="240" Series="{Binding CountSeries}" XAxes="{Binding CountXAxes}" YAxes="{Binding CountYAxes}"
                                        TooltipPosition="Top" LegendPosition="Hidden" Background="Transparent" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Average time per lab" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Minutes per run without deaths, capped at the lab time cap" Style="{StaticResource CardSubtitle}" />
                    <lvc:CartesianChart Height="240" Series="{Binding TimeSeries}" XAxes="{Binding TimeXAxes}" YAxes="{Binding TimeYAxes}"
                                        TooltipPosition="Top" LegendPosition="Hidden" Background="Transparent" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ Per lab ============ -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Best runs" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Fastest run without deaths per lab" Style="{StaticResource CardSubtitle}" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Lab" Style="{StaticResource Head}" />
                        <TextBlock Grid.Column="1" Text="Runs" Style="{StaticResource Head}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="Avg." Style="{StaticResource Head}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Best" Style="{StaticResource Head}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="Best on" Style="{StaticResource Head}" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LabRow}">
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat=N0}" Style="{StaticResource Cell}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="{Binding Average}" Style="{StaticResource Cell}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{Binding BestTime}" Style="{StaticResource Cell}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{Binding BestDate}" Style="{StaticResource Cell}" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="Only runs without deaths count, like in TraXile 2.x. * Unknown: TraXile could not tell the difficulty of the lab." />
                </StackPanel>
            </Border>

            <!-- ============ Lab runs ============ -->
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Lab runs" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="All lab activities in the filter, newest first" Style="{StaticResource CardSubtitle}" />
                    <ItemsControl ItemsSource="{Binding Runs}" MaxHeight="520" Style="{StaticResource CountList}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type svc:ActivityInfo}">
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Area}" Style="{StaticResource Body}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="Deaths" Grid.Column="1" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Run Text="Deaths: " /><Run Text="{Binding Deaths, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{Binding StartedFull}" Style="{StaticResource Cell}" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Duration}" Style="{StaticResource Cell}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Deaths}" Value="0">
                                        <Setter TargetName="Deaths" Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No lab runs in the filtered activities." Style="{StaticResource Meta}"
                               Visibility="{Binding HasData, Converter={StaticResource InvBoolToVis}}" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</Page>
