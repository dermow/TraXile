<Page
    x:Class="TraXile.Next.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:TraXile.Next.ViewModels"
    Title="Settings">

    <Page.Resources>
        <!-- One setting: name and help on the left, the control on the right -->
        <Style x:Key="SettingName" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SettingHelp" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,24,0" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Stored in the same config.xml as the classic TraXile, so both apps use the same settings."
                       Style="{StaticResource Meta}" Margin="0,4,0,24" />

            <Border Style="{StaticResource Notice}" Margin="0,0,0,24" BorderBrush="{DynamicResource StatusWarningBrush}"
                    Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap">
                    <Run Text="Read only" FontWeight="SemiBold" />
                    <Run Text="  Settings can be changed while TraXile.Next tracks live (the classic TraXile must be closed)." Foreground="{DynamicResource TextMutedBrush}" />
                </TextBlock>
            </Border>

            <!-- ============ General ============ -->
            <TextBlock Text="GENERAL" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,28">
                <StackPanel>
                    <!-- Client.txt -->
                    <Grid Margin="24,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Path of Exile log (Client.txt)" Style="{StaticResource SettingName}" />
                            <TextBlock Text="{Binding ClientTxtText}" Style="{StaticResource Meta}" Margin="0,4,24,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding ClientTxtPath}" />
                            <TextBlock Style="{StaticResource SettingHelp}"
                                       Text="Changing it restarts TraXile and reads the new log from the start." />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="Change…" VerticalAlignment="Center" Click="ChangeClientTxt_Click"
                                   IsEnabled="{Binding CanWrite}">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="FolderOpen20" /></ui:Button.Icon>
                        </ui:Button>
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource BgBrush}" />

                    <!-- Theme -->
                    <Grid Margin="24,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Theme" Style="{StaticResource SettingName}" />
                            <TextBlock Style="{StaticResource SettingHelp}" Text="Also switchable with the button in the title bar." />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource SegmentedGroup}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Content="Dark" IsChecked="{Binding IsDark}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Content="Light" IsChecked="{Binding IsLight}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource BgBrush}" />

                    <!-- Minimize to tray -->
                    <Grid Margin="24,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Minimize to tray" Style="{StaticResource SettingName}" />
                            <TextBlock Style="{StaticResource SettingHelp}"
                                       Text="When minimized, TraXile hides from the taskbar and keeps tracking in the notification area. Double-click the icon to open it again." />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding MinimizeToTray}" IsEnabled="{Binding CanWrite}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ Time caps ============ -->
            <TextBlock Text="TIME CAPS" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,28">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingHelp}" Margin="0,0,0,16"
                               Text="Activities that run longer than their cap (e.g. you went AFK) count with the cap in statistics. Values in seconds." />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Minimum time" Style="{StaticResource SettingName}" />
                            <TextBlock Style="{StaticResource SettingHelp}" Text="Shorter activities are not tracked. Applies after a restart." />
                        </StackPanel>
                        <ui:TextBox Grid.Column="1" Width="110" VerticalAlignment="Center" TextAlignment="Right"
                                    Text="{Binding MinimumText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanWrite}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding TimeCaps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TimeCapRow}">
                                <Border x:Name="Row" Background="{DynamicResource SurfaceRowBrush}" CornerRadius="{StaticResource SurfaceRadius}"
                                        Margin="0,0,8,4" Padding="12,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{Binding Brush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            <TextBlock x:Name="Duration" Text="{Binding DurationText}" Style="{StaticResource Caption}" Typography.NumeralAlignment="Tabular" />
                                        </StackPanel>
                                        <ui:TextBox Grid.Column="2" Width="86" MinHeight="32" FontSize="13" TextAlignment="Right" VerticalAlignment="Center"
                                                    Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                    IsEnabled="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=Page}}" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsValid}" Value="False">
                                        <Setter TargetName="Duration" Property="Foreground" Value="{DynamicResource StatusDangerBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TimeCapStatus}" Style="{StaticResource Meta}" VerticalAlignment="Center" />
                            <ui:Button Content="Restart now" Appearance="Transparent" Margin="8,0,0,0" Click="RestartNow_Click"
                                       Visibility="{Binding NeedsRestart, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <ui:Button Content="Save time caps" Appearance="Primary" HorizontalAlignment="Right" Click="SaveTimeCaps_Click"
                                   IsEnabled="{Binding CanWrite}" />
                    </Grid>
                </StackPanel>
            </Border>
            <!-- ============ Maintenance ============ -->
            <TextBlock Text="MAINTENANCE" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,28">
                <StackPanel>
                    <Grid Margin="24,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Reload log" Style="{StaticResource SettingName}" />
                            <TextBlock Style="{StaticResource SettingHelp}"
                                       Text="Reads Client.txt again from the start and rebuilds all activities. Tags and pauses you added by hand are lost." />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="Reload…" VerticalAlignment="Center" Click="Reload_Click" IsEnabled="{Binding CanMaintain}">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise20" /></ui:Button.Icon>
                        </ui:Button>
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource BgBrush}" />

                    <Grid Margin="24,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Shrink log" Style="{StaticResource SettingName}" />
                            <TextBlock Style="{StaticResource SettingHelp}"
                                       Text="Keeps a copy of Client.txt next to it and empties the original, so TraXile starts fast again. Your history stays." />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="Shrink…" VerticalAlignment="Center" Click="Shrink_Click" IsEnabled="{Binding CanMaintain}">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowMinimize20" /></ui:Button.Icon>
                        </ui:Button>
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource BgBrush}" />

                    <Grid Margin="24,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Full reset" Style="{StaticResource SettingName}" />
                            <TextBlock Style="{StaticResource SettingHelp}"
                                       Text="Deletes all activities and statistics and empties Client.txt. You can create a backup first." />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="Reset…" Appearance="Danger" VerticalAlignment="Center" Click="Reset_Click" IsEnabled="{Binding CanMaintain}">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Delete20" /></ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </StackPanel>
            </Border>        </StackPanel>
    </ScrollViewer>
</Page>
