<ui:FluentWindow
    x:Class="TraXile.Next.Views.UpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="TraXile update"
    Width="560"
    Height="520"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource BgBrush}"
    Foreground="{DynamicResource TextBrush}"
    FontFamily="{StaticResource UiFont}">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Background="{DynamicResource BgBrush}" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <ui:SymbolIcon Symbol="Timer24" FontSize="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                    <TextBlock Text="TraXile" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="32,8,32,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="StateLabel" Text="UPDATE AVAILABLE" Style="{StaticResource Label}" Foreground="{DynamicResource AccentTextBrush}" />
            <TextBlock x:Name="Headline" Grid.Row="1" Style="{StaticResource H2}" Margin="0,8,0,16" TextWrapping="Wrap" />

            <!-- installed vs. latest -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Installed" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding CurrentVersion}" Style="{StaticResource Num}" FontWeight="SemiBold" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Latest" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding LatestVersion}" Style="{StaticResource Num}" FontWeight="SemiBold" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <DockPanel Grid.Row="3">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" Margin="0,0,0,10">
                    <Run Text="WHAT'S NEW IN" /> <Run Text="{Binding LatestVersion, Mode=OneWay}" />
                </TextBlock>
                <TextBlock DockPanel.Dock="Top" Text="No changes listed for this version." Style="{StaticResource Meta}"
                           Visibility="{Binding HasChanges, Converter={StaticResource InvBoolToVis}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Changes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,7,0,0"
                                             HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- footer -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" Padding="32,16">
            <Grid>
                <TextBlock x:Name="ErrorText" Style="{StaticResource Meta}" Foreground="{DynamicResource StatusDangerBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,260,0" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="CloseButton" Content="Later" Appearance="Transparent" Margin="0,0,8,0" IsCancel="True" Click="Close_Click" />
                    <ui:Button x:Name="InstallButton" Content="Install update" Appearance="Primary" IsDefault="True" Click="Install_Click">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowDownload20" /></ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
