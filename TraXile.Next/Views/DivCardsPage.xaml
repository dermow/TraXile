<Page
    x:Class="TraXile.Next.Views.DivCardsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:svc="clr-namespace:TraXile.Next.Services"
    xmlns:views="clr-namespace:TraXile.Next.Views"
    xmlns:local="clr-namespace:TraXile.Next"
    Title="Div Cards"
    ScrollViewer.CanContentScroll="False">
    <!-- CanContentScroll=False: the page fills the window, the card list scrolls (and virtualizes) by itself -->

    <Page.Resources>
        <local:EnumEqualsConverter x:Key="EnumEq" />

        <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Sortable column header. Tag = "this column is the sort column" (bool); the arrow looks like CardColumnHeader's. -->
        <Style x:Key="SortHead" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Label" Grid.Column="1" Text="{TemplateBinding Content}" Style="{StaticResource Head}" VerticalAlignment="Center" />
                            <Path x:Name="SortArrow" Grid.Column="2" Width="8" Height="5" Margin="6,1,0,0" Stretch="Fill" VerticalAlignment="Center"
                                  Fill="{DynamicResource AccentTextBrush}" Visibility="Collapsed" Data="M0,0 L1,0 0.5,1 z" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="HorizontalAlignment" Value="Right">
                                <Setter TargetName="SortArrow" Property="Grid.Column" Value="0" />
                                <Setter TargetName="SortArrow" Property="Margin" Value="0,1,6,0" />
                            </Trigger>
                            <Trigger Property="Tag" Value="True">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding SortDescending}" Value="False">
                                <Setter TargetName="SortArrow" Property="Data" Value="M0,1 L1,1 0.5,0 z" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Header ============ -->
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Div Cards" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource Meta}" Margin="0,4,0,0" TextWrapping="Wrap">
                    <Run Text="{Binding Summary, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    <Run Text=" · Only the time range of the filter applies: TraXile records cards without the activity they dropped in." />
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                <ui:TextBox Width="300" PlaceholderText="Search cards…" ClearButtonEnabled="True"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.Icon><ui:SymbolIcon Symbol="Search20" /></ui:TextBox.Icon>
                </ui:TextBox>
                <ui:Button Content="Export CSV" Appearance="Secondary" Margin="10,0,0,0" Click="Export_Click"
                           ToolTip="Export the listed cards as CSV">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowDownload20" /></ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Grid>

        <views:GlobalFilterBar Grid.Row="1" Margin="0,0,0,16" />

        <!-- ============ Column header ============ -->
        <Grid Grid.Row="3" Margin="19,0,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <Button Content="Card" Style="{StaticResource SortHead}" Click="SortHeader_Click" CommandParameter="Name"
                    Tag="{Binding SortColumn, Converter={StaticResource EnumEq}, ConverterParameter=Name}" />
            <Button Grid.Column="1" Content="Count" Style="{StaticResource SortHead}" HorizontalAlignment="Right"
                    Click="SortHeader_Click" CommandParameter="Count"
                    Tag="{Binding SortColumn, Converter={StaticResource EnumEq}, ConverterParameter=Count}" />
            <Button Grid.Column="2" Content="Last draw" Style="{StaticResource SortHead}" HorizontalAlignment="Right"
                    Click="SortHeader_Click" CommandParameter="LastDraw"
                    Tag="{Binding SortColumn, Converter={StaticResource EnumEq}, ConverterParameter=LastDraw}" />
            <Button Grid.Column="3" Content="First draw" Style="{StaticResource SortHead}" HorizontalAlignment="Right"
                    Click="SortHeader_Click" CommandParameter="FirstDraw"
                    Tag="{Binding SortColumn, Converter={StaticResource EnumEq}, ConverterParameter=FirstDraw}" />
        </Grid>

        <!-- ============ Card list ============ -->
        <Grid Grid.Row="4">
            <ListBox ItemsSource="{Binding Items}" ItemContainerStyle="{StaticResource CardListItem}" Background="Transparent"
                     BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False" Padding="0,0,8,0" CanContentScroll="True">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type svc:DivCardInfo}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat=N0}" Style="{StaticResource Num}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="{Binding LastText}" Style="{StaticResource Num}" FontSize="13" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Column="3" Text="{Binding FirstText}" Style="{StaticResource Num}" FontSize="13" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <ui:SymbolIcon Symbol="Collections24" FontSize="40" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Meta}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
