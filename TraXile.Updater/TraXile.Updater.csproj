<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Downloads Setup.msi of the requested release and runs it (started by TraXile with the target version).
    Target framework, platform and runtime version come from Directory.Build.props, so app and updater
    share one self-contained runtime (docs/adr/0006).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>TraXile.Updater</RootNamespace>
    <AssemblyName>TraXile.Updater</AssemblyName>
    <ApplicationIcon>ic-task.ico</ApplicationIcon>
    <Product>TraXile.Updater</Product>
    <Company>dermow</Company>
    <Copyright>Copyright © 2021</Copyright>
    <Version>1.1.2</Version>
  </PropertyGroup>

</Project>
